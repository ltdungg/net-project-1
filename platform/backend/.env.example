POSTGRES_DB=net_commerce
POSTGRES_USER=net
POSTGRES_PASSWORD=net_local_password
DB_POOL_SIZE=10

APP_ENV=local
PUBLIC_ORIGIN=http://localhost:8787
JWT_SECRET=local-development-jwt-secret-change-before-production-2026
PAYMENT_WEBHOOK_SECRET=local-development-webhook-secret-change-me
LOCAL_AUTH_BYPASS=false
LOCAL_AUTH_EMAIL=owner@example.com
ADMIN_EMAILS=owner@example.com
MANAGER_EMAILS=manager@example.com

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
API_PORT=8080
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC

# Optional: enable Gemini shopping advice and admin dashboard planning.
# Keep this key on the backend only. Empty key uses the local recommendation/rule engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# SePay API v2 Test mode only. Never use a Live API token here.
SEPAY_SANDBOX_ENABLED=false
SEPAY_SANDBOX_API_KEY=
SEPAY_SANDBOX_BANK_ACCOUNT_ID=
