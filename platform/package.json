{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:smoke": "node ops/smoke-test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 execute site-creator-d1 --local --config=wrangler.local.jsonc --file=drizzle/0000_cold_red_wolf.sql",
    "db:seed:local": "wrangler d1 execute site-creator-d1 --local --config=wrangler.local.jsonc --file=db/seed.sql"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "^19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "^19.2.8",
    "recharts": "3.8.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "^1.0.0-beta.8",
    "wrangler": "4.127.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20260830.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "drizzle-kit": "0.31.11",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
